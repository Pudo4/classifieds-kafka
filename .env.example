# Copy to .env before `docker compose up`.
# Each service gets its own Postgres user + database; no service's credentials
# grant access to another service's database (enforced by docker/postgres/init-multi-db.sh).

# --- Postgres superuser (used only by the init script to create per-service DBs/users) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

# --- Per-service Postgres credentials ---
LISTING_DB_NAME=listings_db
LISTING_DB_USER=listing_svc
LISTING_DB_PASSWORD=listing_pw

MEDIA_DB_NAME=media_db
MEDIA_DB_USER=media_svc
MEDIA_DB_PASSWORD=media_pw

ENGAGEMENT_DB_NAME=engagement_db
ENGAGEMENT_DB_USER=engagement_svc
ENGAGEMENT_DB_PASSWORD=engagement_pw

MODERATION_DB_NAME=moderation_db
MODERATION_DB_USER=moderation_svc
MODERATION_DB_PASSWORD=moderation_pw

NOTIFICATION_DB_NAME=notifications_db
NOTIFICATION_DB_USER=notification_svc
NOTIFICATION_DB_PASSWORD=notification_pw

# --- Postgres host port (container always listens on 5432) ---
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Kafka (KRaft, single broker) ---
KAFKA_HOST_PORT=9092
KAFKA_BROKERS=localhost:9092

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Meilisearch ---
MEILI_MASTER_KEY=local_dev_master_key_change_me
MEILI_PORT=7700

# --- Host-side ports for the app services (services/*, web), when run via
# `docker compose up` instead of `npm run dev` locally. These only affect
# what's published to the host -- containers always talk to each other over
# the internal Docker network at each service's fixed internal port
# (3000-3006, 5173), so changing these never breaks inter-service calls.
# Change one here if something else on your machine already uses that port. ---
LISTING_HOST_PORT=3001
SEARCH_HOST_PORT=3002
MODERATION_HOST_PORT=3003
MEDIA_HOST_PORT=3004
ENGAGEMENT_HOST_PORT=3005
NOTIFICATION_HOST_PORT=3006
BFF_HOST_PORT=3000
WEB_HOST_PORT=5173
